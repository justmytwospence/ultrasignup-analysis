# Copy to .env (gitignored) and fill in. utils/mirror.py reads these.
# The mirror's WireGuard-only Quack endpoint (Traefik terminates TLS on 443).
ULTRASIGNUP_QUACK_URI=quack:ultrasignup.example.com:443
# The mirror's read-only Quack token (QUACK_TOKEN in ~/homelab/ultrasignup/.env on the NUC).
ULTRASIGNUP_QUACK_TOKEN=
