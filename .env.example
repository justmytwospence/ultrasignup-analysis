# Copy to .env (gitignored) and fill in. utils/mirror.py reads these.
# The mirror's WireGuard-only Quack endpoint (Traefik terminates TLS on 443).
ULTRASIGNUP_QUACK_URI=quack:ultrasignup.spencerboucher.com:443
# The mirror's read-only Quack token (ULTRASIGNUP_QUACK_TOKEN in ~/homelab/ultrasignup/.env on the NUC).
ULTRASIGNUP_QUACK_TOKEN=
# live (default): every load queries the NUC. local: read data/mirror.duckdb from
# utils.mirror.pull(), so refits and their caches see one fixed copy of the data.
ULTRASIGNUP_SOURCE=live
