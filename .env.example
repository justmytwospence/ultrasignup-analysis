# Copy to .env (gitignored) and fill in. utils/data_source.py reads these.
# The data source's WireGuard-only Quack endpoint (Traefik terminates TLS on 443).
ULTRASIGNUP_QUACK_URI=quack:ultrasignup.spencerboucher.com:443
# The data source's read-only Quack token (ULTRASIGNUP_QUACK_TOKEN in ~/homelab/ultrasignup/.env on the NUC).
ULTRASIGNUP_QUACK_TOKEN=
# live (default): every load queries the NUC. local: read data/results.duckdb from
# utils.data_source.pull(), so refits and their caches see one fixed copy of the data.
ULTRASIGNUP_SOURCE=live
